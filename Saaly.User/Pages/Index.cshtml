@page
@model IndexModel
@{
    Layout = "_Public.Layout";
    ViewData["Title"] = "Home";
}


<style>
    .card-icon-header{
        width: 5rem;
        height: 5rem;
        margin-bottom: 5rem;
        border-radius: 60%;
    }

    .card-space{
        height: 2rem;
        width: 100%;
    }

    .btn-card{
        width: 10rem;
        margin: 1rem auto;
    }

    .landing-page-container{
        width: 80%;
        height: 20rem;
        margin: auto
    }

    @@media (max-width: 768px) {
        .my-list {
            min-height: 30px;
            width: 100%;
        }

        .card {
            margin: 3rem auto;
        }

        
    }
    @@media (min-width: 768px) {
        .my-list {
            display: flex;
            justify-content: space-around;
            min-height: 300px;
        }

        .card {
            width:32%;
            height: 18rem;
            margin:0rem 3rem;
        }
    }
</style>
