@page
@model CreateModel
@{
    ViewData["Title"] = "Edit Admin";
    ViewData["IsAdminActive"] = "active";
}

@section Hero
{
    <div class="bg-body-light">
        <div class="content content-full">
            <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-center py-2">
                <div class="flex-grow-1">
                    <h1 class="h3 fw-bold mb-1">
                        Clients
                    </h1>
                    <h2 class="fs-base lh-base fw-medium text-muted mb-0">
                        Mobile friendly tables that work across all screen sizes.
                    </h2>
                </div>
                <breadcrumb crumbs="Model.BreadCrumbs"></breadcrumb>
            </div>
        </div>
    </div>
}

<!-- Floating Labels -->
<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">Create Clients</h3>
    </div>
    <div class="block-content block-content-full">
        <form method="POST">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <div class="form-floating mb-4">
                        <input asp-for="Model.Name" class="form-control" />
                        <label asp-for="Model.Name" class="control-label"></label>
                        <span asp-validation-for="Model.Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="Model.ManagementCompany" class="form-control" />
                        <label asp-for="Model.ManagementCompany" class="control-label"></label>
                        <span asp-validation-for="Model.ManagementCompany" class="text-danger"></span>
                    </div>
                    
                    @await Html.PartialAsync("Components/Contact", Model.Model.Contact, new ViewDataDictionary(ViewData)
                    {
                        TemplateInfo = { HtmlFieldPrefix = "Model.Contact" }
                    })
                    <div class="form-floating mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="Model.IsActive" class="form-check-input" />
                            <label asp-for="Model.IsActive" class="control-label">Enable</label>
                        </div>
                    </div>
                    <div class="mb-4">
                        <button type="submit" class="btn btn-lg btn-primary">Save</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- END Floating Labels -->