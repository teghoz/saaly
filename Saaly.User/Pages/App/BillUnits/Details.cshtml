@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model DetailsModel

@{
}

@section Hero
{
    <div class="bg-body-light">
        <div class="content content-full">
            <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-center py-2">
                <div class="flex-grow-1">
                    <h1 class="h3 fw-bold mb-1">
                        @ViewData["Title"]
                    </h1>
                    <h2 class="fs-base lh-base fw-medium text-muted mb-0">
                        Mobile friendly tables that work across all screen sizes.
                    </h2>
                </div>
                <breadcrumb crumbs="Model.BreadCrumbs"></breadcrumb>
            </div>
        </div>
    </div>
}

<div class="block block-rounded">
    <div class="block-header block-header-default">
        <h3 class="block-title">@ViewData["Title"]</h3>
    </div>
    <div class="block-content block-content-full">
        <div class="ibox">
            @*<a href="javascript: history.back()" class="btn btn-primary"><i class="fa fa-arrow-left"></i> Back to List</a>*@
    
            <div class="ibox-body">
                <h3>Are you sure you want to delete this?</h3>
                <hr/>
                <div>
                    <dl class="row">
                        @foreach (var property in Model.Model.GetType().GetProperties())
                        {
                            <dt class="col-sm-4">
                                @Html.DisplayName(property.Name)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.Raw(property.GetValue(Model.Model)?.ToString())
                            </dd>
                        }
                    </dl>
    
                     <div>
                         <a asp-page="./Edit" asp-route-guid="@Model.Model.Guid" asp-route-entityGuid="@Model.Model.EntityGuid">Edit</a> |
                         <a asp-page="./Index" asp-route-guid="@Model.Model.Guid" asp-route-entityGuid="@Model.Model.EntityGuid">Back to List</a>
                     </div>
                </div>
            </div>
        </div>
    </div>
</div>




